+			s, dir = resultFixture(t, upstream.URL, true)
+			before, _ := os.ReadFile(filepath.Join(dir, "project-sessions.json"))
+			req := httptest.NewRequest(http.MethodGet, "/v1/sessions/original-session/result", nil)
