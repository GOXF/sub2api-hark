@@ -0,0 +1,30 @@
+package gateway
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestCheckpointCompactionOnlyMatchesLastHarnessCommand(t *testing.T) {
+	// Independently use the actual captured upstream command, not a keyword.
+	const prompt = "You are performing a CONTEXT CHECKPOINT COMPACTION. Create a handoff summary for another LLM that will resume the task.\n\nInclude:\n- Current progress and key decisions made\n- Important context, constraints, or user preferences\n- What remains to be done (clear next steps)\n- Any critical data, examples, or references needed to continue\n\nBe concise, structured, and focused on helping the next LLM seamlessly continue the work."
+	if !isCheckpointCompaction(chatRequest{Messages: []chatMessage{{Role: "user", Content: strings.ReplaceAll(prompt, "\n", "\r\n")}}}) {
+		t.Fatal("captured harness command not recognized")
+	}
+	for _, messages := range [][]chatMessage{
+		{{Role: "user", Content: "Explain this prompt: " + prompt}},
+		{{Role: "user", Content: "Summarize my project"}},
+		{{Role: "assistant", Content: prompt}},
+		{{Role: "user", Content: prompt}, {Role: "user", Content: "Continue the layout task"}},
+	} {
+		if isCheckpointCompaction(chatRequest{Messages: messages}) {
+			t.Fatal("ordinary/history text misclassified")
+		}
+	}
+	if err := declinedTurnFailure(false, &turnResult{Outcome: "declined", Text: "ordinary refusal"}); err == nil {
+		t.Fatal("ordinary refusal accepted as success")
+	}
+	if err := declinedTurnFailure(true, &turnResult{Outcome: "completed", Text: "valid summary"}); err != nil {
+		t.Fatal("valid summary failed")
+	}
+}
diff --git a/declined.go b/declined.go
new file mode 100644
--- /dev/null
+++ b/declined.go
@@ -0,0 +1,42 @@
+package gateway
+
+import (
+	"regexp"
+	"strings"
+	"unicode/utf8"
+)
+
+var (
+	// Anchor the self-refusal to the opening clause, never a provider mention
+	// in an answer. Match the backend-model role, not ordinary inability to help.
+	backendRoleRefusal = regexp.MustCompile(`^(?:Hark[ 	]*|我)(?:不能|不支持|无法|没法)(?:被)?(?:当作|作为|用作|充当)(?:其他|其它|别的|另一个|第三方)(?:应用|程序|软件)(?:背后)?的模型(?:来)?(?:使用|调用|用)?(?:[。，；,;]|$)`)
+	// Only a request to state the task and an offer to help may follow. An
+	// arbitrary suffix could contain real work, a quotation or a negation.
+	backendRoleRedirect = regexp.MustCompile(`^(?:不过|但是|但)?(?:如果)?(?:你(?:可以)?(?:直接)?告诉我(?:你)?(?:实际)?想(?:解决|完成|做成)什么(?:问题|事情|事)?|你想(?:完成|做成)什么事[，,]?(?:可以)?直接告诉我)(?:[，,]比如[^，。；;]{1,80}(?:具体指什么)?)?[，,](?:我很乐意(?:直接)?(?:在这里)?(?:直接)?帮(?:你|忙)|我会在这里帮你)[。！.!]?$`)
+)
+
+// recordedBackendRefusal is a conservative fallback for plain-text refusals.
+// Native declined_notice metadata is handled first by completedProjectReply.
+// History can mark refused jobs completed and expose no machine-readable flag.
+func recordedBackendRefusal(m harkMessage) bool {
+	if m.Role != "assistant" || m.Source != "send_bubble" || m.Presentation.Kind != "text" || m.Streaming == nil || *m.Streaming {
+		return false
+	}
+	text := strings.TrimSpace(m.Content)
+	if text == "" || utf8.RuneCountInString(text) > 512 || strings.ContainsAny(text, "\r\n`") {
+		return false
+	}
+	text = strings.TrimPrefix(text, "抱歉，")
+	if opening := backendRoleRefusal.FindString(text); opening != "" {
+		tail := strings.TrimSpace(strings.TrimPrefix(text, opening))
+		return tail == "" || backendRoleRedirect.MatchString(tail)
+	}
+	// Retain the separately observed packaging-specific refusal. Do not turn
+	// arbitrary quoted/negated model statements into completed-turn failures.
+	const packaging = "这条请求还是另一个应用打包好、交给它自己模型的完整请求，Hark 不支持充当那个模型；"
+	if tail, ok := strings.CutPrefix(text, packaging); ok {
+		return tail == "" || backendRoleRedirect.MatchString(tail) ||
+			tail == "如果你直接告诉我接码授权页现在有哪些区块、想怎么排，我可以在这里帮你出布局方案和改动思路。"
+	}
+	return false
+}
diff --git a/declined_outcome_test.go b/declined_outcome_test.go
new file mode 100644
--- /dev/null
+++ b/declined_outcome_test.go
@@ -0,0 +1,86 @@
+package gateway
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestDeclinedRecordedBackendRefusal(t *testing.T) {
+	b, err := os.ReadFile("testdata/backend_refusal_history.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var trace struct {
+		Turns []struct {
+			RequestID string        `json:"request_id"`
+			Expected  string        `json:"expected"`
+			Messages  []harkMessage `json:"messages"`
+		} `json:"turns"`
+	}
+	if err := json.Unmarshal(b, &trace); err != nil {
+		t.Fatal(err)
+	}
+	for _, turn := range trace.Turns {
+		t.Run(turn.RequestID, func(t *testing.T) {
+			reply, err := completedProjectReply(turn.Messages, turn.Expected, turn.RequestID)
+			if err != nil || reply.Outcome != "declined" || reply.Text != turn.Messages[1].Content {
+				t.Fatalf("raw backend refusal treated as success: outcome=%q body_preserved=%v err=%v", reply.Outcome, reply.Text == turn.Messages[1].Content, err)
+			}
+			screenshot := append([]harkMessage(nil), turn.Messages...)
+			screenshot[1].Content = "抱歉，Hark 不支持作为其他应用背后的模型来使用。如果你告诉我想完成什么，比如把接码授权页改成和注册引擎一样的布局，我很乐意在这里直接帮你。"
+			screenshotReply, screenshotErr := completedProjectReply(screenshot, turn.Expected, turn.RequestID)
+			if screenshotErr != nil || screenshotReply.Outcome != "declined" || screenshotReply.Text != screenshot[1].Content {
+				t.Fatalf("original screenshot refusal lost: outcome=%q err=%v", screenshotReply.Outcome, screenshotErr)
+			}
+			// A quote, user text, another turn, summary, or unfinished bubble is
+			// not an authoritative self-refusal for this completed turn.
+			for _, source := range [][]harkMessage{turn.Messages, screenshot} {
+				for _, variant := range []string{"quote", "user", "other_turn", "summary", "streaming", "negation", "with_work"} {
+					messages := append([]harkMessage(nil), source...)
+					m := &messages[1]
+					switch variant {
+					case "quote":
+						m.Content = "> " + m.Content
+					case "user":
+						m.Role = "user"
+					case "other_turn":
+						m.TriggeredBy = "other"
+					case "summary":
+						m.Presentation.Kind = "summary"
+					case "streaming":
+						yes := true
+						m.Streaming = &yes
+					case "negation":
+						m.Content = "并不是这样：" + m.Content
+					case "with_work":
+						m.Content += "\n已执行修改。"
+					}
+					r, _ := completedProjectReply(messages, turn.Expected, turn.RequestID)
+					if r.Outcome == "declined" {
+						t.Fatalf("false refusal: %s", variant)
+					}
+				}
+			}
+			messages := append([]harkMessage(nil), turn.Messages...)
+			messages[1].Content = "普通回答：可以修改页面布局。"
+			r, err := completedProjectReply(messages, turn.Expected, turn.RequestID)
+			if err != nil || r.Outcome != "completed" || !strings.HasPrefix(r.Text, "普通回答") {
+				t.Fatal("ordinary body changed")
+			}
+		})
+	}
+}
+
+func TestDeclinedStatusIsTerminal(t *testing.T) {
+	var got []turnStatus
+	s := newTurnStatusTracker("c", "a", "u", func(v turnStatus) { got = append(got, v) })
+	s.finishDeclined()
+	s.finishDeclined()
+	yes := true
+	s.history([]harkMessage{{ID: "a", Role: "assistant", TriggeredBy: "u", JobStatus: "running", Streaming: &yes, InputNeeded: true}})
+	if len(got) != 1 || got[0].Status != "ended" || got[0].Reason != "upstream_declined" || got[0].RequestID != "u" || got[0].Sequence != 1 {
+		t.Fatalf("late event replaced terminal refusal: %+v", got)
+	}
+}
