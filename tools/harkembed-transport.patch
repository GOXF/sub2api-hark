@@ -0,0 +1,137 @@
+package gateway
+
+import (
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func issuedDurable(t *testing.T) *durableRig {
+	t.Helper()
+	x := newDurableRig(t, "responses", false)
+	if w := x.post("fixture-key-A", x.path, x.body, false); w.Code != 409 {
+		t.Fatal(w.Body)
+	}
+	if w := x.prepare(); w.Code != 200 {
+		t.Fatal(w.Body)
+	}
+	return x
+}
+
+func TestDurableRecoveryTailCrashGuards(t *testing.T) {
+	for _, mode := range []string{"unknown-acceptance", "store-before-send", "parallel-receipt"} {
+		t.Run(mode, func(t *testing.T) {
+			x := issuedDurable(t)
+			w := x.post("fixture-key-A", x.path, x.body, false)
+			id := regexp.MustCompile(`call_[a-f0-9]+`).FindString(w.Body.String())
+			body := durableTail("responses", x.body, id)
+			switch mode {
+			case "unknown-acceptance":
+				x.mu.Lock()
+				x.tailFailure = 503
+				x.mu.Unlock()
+				w = x.post("fixture-key-A", x.path, body, false)
+				if w.Code != 409 || !strings.Contains(w.Body.String(), "recovery_submission_uncertain") {
+					t.Fatalf("unknown acceptance not retained: %d %s", w.Code, w.Body)
+				}
+				x.restart()
+				w = x.post("fixture-key-A", x.path, body, false)
+				if w.Code != 409 {
+					t.Fatal("restart allowed unknown accepted tail replay")
+				}
+			case "store-before-send":
+				x.s.data = filepath.Join(x.dir, "unavailable-parent")
+				w = x.post("fixture-key-A", x.path, body, false)
+				if w.Code < 400 {
+					t.Fatal("tail was submitted without durable intent")
+				}
+				x.mu.Lock()
+				count := x.sends
+				x.mu.Unlock()
+				if count != 1 {
+					t.Fatal("tail submitted before persistence")
+				}
+				x.s.data = x.dir
+				x.restart()
+				w = x.post("fixture-key-A", x.path, body, false)
+				if w.Code != 200 {
+					t.Fatal(w.Body)
+				}
+			case "parallel-receipt":
+				var wg sync.WaitGroup
+				codes := make(chan int, 4)
+				for i := 0; i < 4; i++ {
+					wg.Add(1)
+					go func() { defer wg.Done(); codes <- x.post("fixture-key-A", x.path, body, false).Code }()
+				}
+				wg.Wait()
+				close(codes)
+				ok := 0
+				for code := range codes {
+					if code == 200 {
+						ok++
+					} else if code != 409 {
+						t.Fatalf("unexpected receipt status %d", code)
+					}
+				}
+				if ok != 1 {
+					t.Fatalf("receipt applied %d times", ok)
+				}
+			}
+			x.mu.Lock()
+			defer x.mu.Unlock()
+			if x.sends != 2 || x.archives != 0 {
+				t.Fatalf("tail repeated: submissions=%d archives=%d", x.sends, x.archives)
+			}
+		})
+	}
+}
+
+func TestDurableRecoveryLegacyAndCorruption(t *testing.T) {
+	t.Run("legacy-no-owner", func(t *testing.T) {
+		x := newDurableRig(t, "responses", false)
+		w := x.post("", x.path, x.body, false)
+		if w.Code != 409 {
+			t.Fatal(w.Body)
+		}
+		w = x.prepare()
+		if w.Code != 409 || !strings.Contains(w.Body.String(), "recovery_contract_unverified") {
+			t.Fatal("legacy context was guessed or adopted")
+		}
+		for _, p := range x.s.projects {
+			if p.OwnerID != "" || p.PendingTurn.Contract != nil {
+				t.Fatal("legacy ownership changed")
+			}
+		}
+	})
+	t.Run("corrupt-wire-fails-closed", func(t *testing.T) {
+		x := issuedDurable(t)
+		path := filepath.Join(x.dir, "project-sessions.json")
+		raw, _ := os.ReadFile(path)
+		var rows map[string]map[string]any
+		_ = json.Unmarshal(raw, &rows)
+		for _, row := range rows {
+			d := row["recovery_delivery"].(map[string]any)
+			d["wire_sha256"] = strings.Repeat("0", 64)
+		}
+		raw, _ = json.Marshal(rows)
+		if err := os.WriteFile(path, raw, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := NewEmbedded(x.dir, Options{Upstream: x.upstream}); err == nil {
+			t.Fatal("corrupted saved wire was reissued after restart")
+		}
+	})
+	t.Run("pending-cannot-end", func(t *testing.T) {
+		x := issuedDurable(t)
+		w := x.post("fixture-key-A", "/v1/sessions/original-session/end", `{}`, false)
+		if w.Code != http.StatusConflict {
+			t.Fatalf("archiving bypassed pending recovery: %d %s", w.Code, w.Body)
+		}
+	})
+}
diff --git a/recovery_delivery_test.go b/recovery_delivery_test.go
new file mode 100644
index 0000000..852e526
--- /dev/null
+++ b/recovery_delivery_test.go
@@ -0,0 +1,206 @@
+package gateway
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type durableRig struct {
+	t                         *testing.T
+	s                         *Server
+	dir, body, path, upstream string
+	mu                        sync.Mutex
+	ready                     bool
+	sends, gets, archives     int
+	turns                     []map[string]any
+	replyText                 string
+	tailFailure               int
+}
+
+func durableCaller(t *testing.T, s *Server, owner string) http.Handler {
+	t.Helper()
+	p, ok := any(s).(interface{ CallerHandler(string) http.Handler })
+	if !ok {
+		t.Fatal("DURABLE_RECOVERY unavailable: no owner-bound delivery and acknowledgment path")
+	}
+	return p.CallerHandler(owner)
+}
+
+func durableControls(t *testing.T, s *Server) http.Handler {
+	t.Helper()
+	p, ok := any(s).(interface{ RecoveryControlHandler() http.Handler })
+	if !ok {
+		t.Fatal("DURABLE_RECOVERY unavailable: no persistent recovery controls")
+	}
+	return p.RecoveryControlHandler()
+}
+
+func newDurableRig(t *testing.T, protocol string, stream bool) *durableRig {
+	t.Helper()
+	x := &durableRig{t: t, dir: t.TempDir()}
+	u := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		x.mu.Lock()
+		defer x.mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/api/conversations":
+			_ = json.NewEncoder(w).Encode(map[string]string{"conversationId": "durable-original-project"})
+		case "/api/messages/send":
+			if r.Method != http.MethodPost {
+				t.Error("wrong submission method")
+			}
+			var p map[string]any
+			_ = json.NewDecoder(r.Body).Decode(&p)
+			x.turns = append(x.turns, p)
+			x.sends++
+			if x.sends > 1 && x.tailFailure != 0 {
+				w.WriteHeader(x.tailFailure)
+				_, _ = w.Write([]byte(`{"error":"synthetic acceptance response lost"}`))
+				return
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"success": true, "conversationId": "durable-original-project", "messageId": p["idempotencyKey"], "redirected": false})
+		case "/api/messages/history":
+			x.gets++
+			if !x.ready {
+				w.WriteHeader(429)
+				_, _ = w.Write([]byte(`{"error":"fixture polling interrupted"}`))
+				return
+			}
+			var messages []any
+			for i, p := range x.turns {
+				text := previewToolText
+				if x.replyText != "" {
+					text = x.replyText
+				}
+				if i > 0 {
+					text = "Mock continuation completed"
+				}
+				messages = append(messages, map[string]any{"id": p["idempotencyKey"], "role": "user"}, map[string]any{"id": p["responseMessageId"], "role": "assistant", "triggeredByMessageId": p["idempotencyKey"], "status": "completed", "content": text})
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"messages": messages})
+		default:
+			if strings.Contains(r.URL.Path, "archive") {
+				x.archives++
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{})
+		}
+	}))
+	t.Cleanup(u.Close)
+	x.upstream = u.URL
+	x.restart()
+	x.path, x.body = previewRequest(protocol, stream)
+	return x
+}
+
+func (x *durableRig) restart() {
+	x.t.Helper()
+	var err error
+	x.s, err = NewEmbedded(x.dir, Options{Upstream: x.upstream, PollInterval: time.Millisecond})
+	if err != nil {
+		x.t.Fatal(err)
+	}
+}
+func (x *durableRig) post(owner, path, body string, control bool) *httptest.ResponseRecorder {
+	x.t.Helper()
+	h := durableCaller(x.t, x.s, owner)
+	if control {
+		h = durableControls(x.t, x.s)
+	}
+	r := httptest.NewRequest(http.MethodPost, path, strings.NewReader(body))
+	r.Header.Set("Content-Type", "application/json")
+	if !control {
+		r.Header.Set("X-Hark-Session-Id", "original-session")
+	}
+	r = r.WithContext(WithEmbeddedAccount(r.Context(), SourceAccount{ID: "sub2api-50", Cookie: "fixture-cookie"}))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	return w
+}
+func (x *durableRig) prepare() *httptest.ResponseRecorder {
+	x.t.Helper()
+	x.mu.Lock()
+	turn := x.turns[0]
+	x.ready = true
+	x.mu.Unlock()
+	var obj any
+	_ = json.Unmarshal([]byte(x.body), &obj)
+	canonical, _ := json.Marshal(obj)
+	text := previewToolText
+	if x.replyText != "" {
+		text = x.replyText
+	}
+	b, _ := json.Marshal(map[string]any{"owner_id": "fixture-key-A", "request_id": turn["idempotencyKey"], "response_message_id": turn["responseMessageId"], "request_sha256": previewSHA(canonical), "result_sha256": previewSHA([]byte(text))})
+	return x.post("", "/v1/sessions/original-session/recovery/prepare", string(b), true)
+}
+
+func TestDurableRecoveryLifecycle(t *testing.T) {
+	x := newDurableRig(t, "responses", false)
+	w := x.post("fixture-key-A", x.path, x.body, false)
+	if w.Code != 409 || !strings.Contains(w.Body.String(), "upstream_turn_interrupted") {
+		t.Fatalf("initial interruption not preserved: %d %s", w.Code, w.Body)
+	}
+	x.restart()
+	w = x.prepare()
+	if w.Code != 200 {
+		t.Fatalf("prepare failed: %d %s", w.Code, w.Body)
+	}
+	x.restart()
+	w = x.post("fixture-key-A", x.path, x.body, false)
+	if w.Code != 200 {
+		t.Fatalf("persisted delivery unavailable: %d %s", w.Code, w.Body)
+	}
+	var envelope map[string]json.RawMessage
+	_ = json.Unmarshal(w.Body.Bytes(), &envelope)
+	var items []map[string]any
+	_ = json.Unmarshal(envelope["output"], &items)
+	if len(items) != 1 || items[0]["name"] != "fixture_probe" {
+		t.Fatalf("missing recovered mock call: %s", w.Body)
+	}
+	callID, _ := items[0]["call_id"].(string)
+	if !strings.HasPrefix(callID, "call_") {
+		t.Fatal("invalid stable call ID")
+	}
+	before, _ := os.ReadFile(filepath.Join(x.dir, "project-sessions.json"))
+	x.restart()
+	again := x.post("fixture-key-A", x.path, x.body, false)
+	if again.Code != 409 || !strings.Contains(again.Body.String(), "recovery_delivery_uncertain") {
+		t.Fatalf("duplicate tool execution was possible: %d %s", again.Code, again.Body)
+	}
+	var b map[string]any
+	_ = json.Unmarshal([]byte(x.body), &b)
+	b["tool_choice"] = "auto"
+	b["input"] = []any{map[string]any{"role": "user", "content": "Inspect mock fixture only"}, map[string]any{"type": "function_call", "call_id": callID, "name": "fixture_probe", "arguments": `{"id":"fixture-only"}`}, map[string]any{"type": "function_call_output", "call_id": callID, "output": "MOCK_RESULT durable fixture"}}
+	tail, _ := json.Marshal(b)
+	w = x.post("fixture-key-A", x.path, string(tail), false)
+	if w.Code != 200 || !strings.Contains(w.Body.String(), "Mock continuation completed") {
+		t.Fatalf("tail-only continuation failed: %d %s", w.Code, w.Body)
+	}
+	x.restart()
+	again = x.post("fixture-key-A", x.path, string(tail), false)
+	if again.Code != 409 {
+		t.Fatalf("ack/tail replay was not idempotent: %d %s", again.Code, again.Body)
+	}
+	x.mu.Lock()
+	defer x.mu.Unlock()
+	if x.sends != 2 || x.archives != 0 || len(x.turns) != 2 {
+		t.Fatalf("replayed original task: sends=%d archives=%d", x.sends, x.archives)
+	}
+	sent, _ := x.turns[1]["message"].(string)
+	if strings.Contains(sent, "Inspect mock fixture only") || !strings.Contains(sent, "MOCK_RESULT durable fixture") {
+		t.Fatal("original task or assistant call was resent instead of only tool output")
+	}
+	after, _ := os.ReadFile(filepath.Join(x.dir, "project-sessions.json"))
+	if bytes.Equal(before, after) {
+		t.Fatal("verified acknowledgment/continuation was not persisted")
+	}
+	t.Log(fmt.Sprintf("DURABLE_RECOVERY initial_send=1 recovered_delivery=1 duplicate_delivery=409 tool_output_tail=1 duplicate_tail=409 archives=0 restart_preserved=true"))
+}
diff --git a/recovery_preview.go b/recovery_preview.go
new file mode 100644
index 0000000..3416d12
--- /dev/null
+++ b/recovery_preview.go
@@ -0,0 +1,190 @@
+package gateway
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"slices"
+	"strings"
+)
+
+// recoveryPreviewProof must be supplied by a trusted in-process test host,
+// using a previously captured client request and an explicitly reviewed native
+// result. It is not a network header, API-key scope, or acknowledgment token.
+type recoveryPreviewProof struct {
+	AccountID         string `json:"account_id"`
+	SessionID         string `json:"session_id"`
+	ProjectID         string `json:"project_id"`
+	RequestID         string `json:"request_id"`
+	ResponseMessageID string `json:"response_message_id"`
+	Path              string `json:"path"`
+	RequestSHA256     string `json:"request_sha256"`
+	ResultSHA256      string `json:"result_sha256"`
+}
+
+// RecoveryPreviewHandler is an isolated feasibility seam. Deliberately NOT
+// registered in Handler, EmbeddedHandler or the sub2api admin/model routes.
+// It only renders a reviewed saved result into an existing client wire format;
+// it never clears pending, installs context, submits a turn or executes a tool.
+// A real host arm/ownership/acknowledgment protocol remains out of scope.
+func (s *Server) RecoveryPreviewHandler(raw json.RawMessage) http.Handler {
+	var proof recoveryPreviewProof
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	err := decoder.Decode(&proof)
+	valid := err == nil && decoder.Decode(&struct{}{}) == io.EOF &&
+		validResultID(proof.AccountID) && validResultID(proof.SessionID) &&
+		validResultID(proof.ProjectID) &&
+		validResultID(proof.RequestID) && validResultID(proof.ResponseMessageID) &&
+		validPreviewSHA(proof.RequestSHA256) && validPreviewSHA(proof.ResultSHA256) &&
+		slices.Contains([]string{"/v1/chat/completions", "/v1/responses", "/v1/messages"}, proof.Path)
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		w.Header().Set("X-Content-Type-Options", "nosniff")
+		a, ok := embeddedAccount(r.Context())
+		if !ok || s.embed == nil || a.ID != proof.AccountID {
+			fail(w, 403, "recovery_preview_owner_mismatch", "预演需要明确绑定原账号；未换号或重发")
+			return
+		}
+		if !valid || r.Method != http.MethodPost || r.URL.Path != proof.Path || r.URL.RawQuery != "" {
+			fail(w, 400, "recovery_preview_invalid_proof", "预演凭据或协议入口不匹配")
+			return
+		}
+		body, readErr := io.ReadAll(io.LimitReader(r.Body, s.maxChatBody()+1))
+		if readErr != nil || int64(len(body)) > s.maxChatBody() || previewDigest(body) != proof.RequestSHA256 {
+			fail(w, 409, "recovery_preview_request_mismatch", "客户端原请求或工具协议已变化；未安装结果")
+			return
+		}
+		var v chatRequest
+		var format outputFormat
+		var parseErr error
+		switch proof.Path {
+		case "/v1/responses":
+			v, parseErr = s.normalizeResponses(body)
+			format = newResponsesFormat()
+		case "/v1/messages":
+			var model string
+			v, model, parseErr = s.normalizeMessages(body)
+			format = newAnthropicFormat(model)
+		default:
+			v, parseErr = s.normalizeChat(body)
+			format = newChatFormat()
+		}
+		if parseErr == nil {
+			parseErr = applySessionHeaders(r, &v)
+		}
+		if parseErr != nil || v.SessionID != proof.SessionID || v.SessionEnd || v.Bridge || isCheckpointCompaction(v) || s.forwardExtra {
+			fail(w, 409, "recovery_preview_context_mismatch", "预演只接受原会话的原执行协议，不接受归档、摘要或额外转发")
+			return
+		}
+		if toolErr := validateClientToolRequest(v, false); toolErr != nil {
+			status, code, message := turnError(r.Context(), toolErr)
+			fail(w, status, code, message)
+			return
+		}
+		// The exact client request digest covers tools and their schemas; saved
+		// client fingerprints independently bind its history to this Project.
+		s.projectMu.Lock()
+		p := s.projects[projectMapping(r, proof.SessionID)]
+		historyMatches := false
+		if p != nil && p.AccountID == proof.AccountID && p.ConversationID == proof.ProjectID {
+			sent := p.Sent
+			if p.LabelHistoryVersion == 2 {
+				sent = p.ClientSent
+			}
+			historyMatches = len(sent) > 0 && slices.Equal(sent, hashes(v.Messages))
+		}
+		s.projectMu.Unlock()
+		if !historyMatches {
+			fail(w, 409, "recovery_preview_history_mismatch", "原客户端历史无法与已受理游标精确对应；未修改 Project")
+			return
+		}
+		lookup := r.Clone(r.Context())
+		lookup.Method = http.MethodGet
+		u := *r.URL
+		lookup.URL = &u
+		lookup.SetPathValue("id", proof.SessionID)
+		lookup.URL.RawQuery = url.Values{"request_id": {proof.RequestID}, "response_message_id": {proof.ResponseMessageID}}.Encode()
+		result, resultErr := s.readSessionResult(lookup, proof.ProjectID)
+		if resultErr != nil {
+			status, code, message := turnError(r.Context(), resultErr)
+			fail(w, status, code, message)
+			return
+		}
+		res := &turnResult{Reused: true, Mode: "recovery-preview", Isolation: "key-session", Text: result.Result.Text, Outcome: "completed"}
+		if result.Status == "declined" {
+			res.Outcome = "declined"
+			status, code, message := turnError(r.Context(), declinedTurnFailure(false, res))
+			fail(w, status, code, message)
+			return
+		}
+		if result.Status == "failed" {
+			status := http.StatusBadGateway
+			if result.ErrorCode == "upstream_budget_exhausted" {
+				status = http.StatusTooManyRequests
+			}
+			fail(w, status, result.ErrorCode, result.ErrorMessage)
+			return
+		}
+		if result.Status != "completed" && result.Status != "awaiting_client_tool" || len(result.Result.Attachments) > 0 {
+			fail(w, 409, "recovery_preview_not_ready", "原结果未完整完成或包含未验收附件；未应用续接")
+			return
+		}
+		if previewDigest([]byte(res.Text)) != proof.ResultSHA256 {
+			fail(w, 409, "recovery_preview_result_mismatch", "上游结果与明确审阅的原文不同；未输出工具调用")
+			return
+		}
+		s.applyToolCalls(v, res)
+		if strings.Contains(res.Text, "<tool_call") {
+			fail(w, 422, "recovery_preview_tool_mismatch", "原工具调用不能被当前工具协议完整解析；未执行")
+			return
+		}
+		if toolErr := validateClientToolResult(v, res.ToolCalls); toolErr != nil {
+			status, code, message := turnError(r.Context(), toolErr)
+			fail(w, status, code, message)
+			return
+		}
+		for i := range res.ToolCalls {
+			call := &res.ToolCalls[i]
+			call.ID = "call_" + previewDigest([]byte(proof.AccountID + "\x00" + proof.SessionID + "\x00" + proof.ResponseMessageID + "\x00" + proof.RequestSHA256 + fmt.Sprintf("\x00%d", i)))[:24]
+		}
+		setTurnHeaders(w, res)
+		w.Header().Set("X-Hark-Recovery-Preview", "true")
+		w.Header().Set("X-Hark-Continuation-Applied", "false")
+		if !v.Stream {
+			write(w, 200, format.json(res))
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.WriteHeader(http.StatusOK)
+		emit := func(event string, value any) {
+			b, _ := json.Marshal(value)
+			if event != "" {
+				_, _ = fmt.Fprintf(w, "event: %s\n", event)
+			}
+			_, _ = fmt.Fprintf(w, "data: %s\n\n", b)
+		}
+		format.start(emit)
+		if res.Text != "" {
+			format.delta(emit, res.Text)
+		}
+		format.finish(emit, res.Text, res.ToolCalls)
+		if format.done() {
+			_, _ = fmt.Fprint(w, "data: [DONE]\n\n")
+		}
+		if f, ok := w.(http.Flusher); ok {
+			f.Flush()
+		}
+	})
+}
+
+func previewDigest(b []byte) string { h := sha256.Sum256(b); return hex.EncodeToString(h[:]) }
+func validPreviewSHA(value string) bool {
+	b, err := hex.DecodeString(value)
+	return err == nil && len(b) == sha256.Size && strings.ToLower(value) == value
+}
